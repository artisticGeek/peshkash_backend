# Production and full local development
DATABASE_URL=postgres://user:password@localhost:5432/peshkash
PORT=4000
JWT_SECRET=replace-me

# WhatsApp Business Platform (official Cloud API). Map each composer template key
# to an approved Meta template name, for example {"new_collection":"new_collection_update"}.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_MAP_JSON={}

# Browser push notifications. Generate once with `npx web-push generate-vapid-keys`.
VAPID_SUBJECT=mailto:hello@peshkash.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# For a database-free QR Studio preview, use `npm run dev:studio` instead.
# Saved Studio drafts then fall back to browser-local storage.
